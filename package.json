{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "finanstar",
  "private": true,
  "version": "0.1.0",
  "description": "FinanStar - app de finanzas personales (React Native + NestJS + MongoDB)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @finanstar/api start:dev",
    "dev:mobile": "pnpm --filter @finanstar/mobile start",
    "build:api": "pnpm --filter @finanstar/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
